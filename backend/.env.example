# Required for Gemini-based reading, chat, and report generation
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Qwen models and Deep Research retrieval/rerank
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Optional: override the DashScope OpenAI-compatible endpoint
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: enables DeepSeek V4 reading, chat, reports, and Deep Research
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: override the DeepSeek OpenAI-compatible endpoint
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: cap extracted PDF text sent to DeepSeek per request
# DEEPSEEK_MAX_PAPER_CHARS=800000

# Optional: set to enabled to use DeepSeek thinking mode
# DEEPSEEK_THINKING=disabled

# Optional: required only for uploading research packs to GitHub Releases
# GITHUB_TOKEN=ghp_xxx
